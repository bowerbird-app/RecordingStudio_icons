<div class="space-y-10">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Configuration reference",
    subtitle: "Set the defaults used when shorthand icon names are normalized.",
    variant: :h1
  ) %>

  <section class="space-y-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Default library",
      subtitle: "Use config/recording_studio_icons.yml to choose the library and variant for string and symbol icon references.",
      anchor_link: true,
      anchor_id: "load-sources"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "config/recording_studio_icons.yml",
      code: @configuration_flags_example,
      language: "yaml",
      separated: false
    ) %>
  </section>

  <section class="space-y-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Override icons",
      subtitle: "Use this when the app needs to override icons registered by other gems.",
      anchor_link: true,
      anchor_id: "override-icons"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Override examples",
      snippets: @configuration_override_examples,
      separated: false
    ) %>
  </section>
</div>